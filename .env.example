# Copy to .env.production.local when you add a real backend API.
# REACT_APP_API_URL=https://api.your-domain.com

# Vercel serverless (api/cedula.js) — set in Vercel project env, not in the browser.
# VERIFIK_API_KEY=your_verifik_jwt_or_api_token

# Auth backend (api/auth/*.js) — set in Vercel project env, not in the browser.
# DATABASE_URL is injected automatically once you add a Postgres/Neon database
# in the Vercel dashboard (Storage tab). SESSION_SECRET you generate yourself,
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
# DATABASE_URL=postgres://...
# SESSION_SECRET=a-long-random-string

# Optional: expose dev server on your local network (copy to .env.development.local)
# HOST=0.0.0.0
